# Copiá este archivo a `.env` (sin el `.ejemplo`) y completá tus valores.
# El `.env` real NUNCA se sube al repo.

# --- Tu proveedor de LLM (lo ponés vos) ---
# Tu API key del proveedor. Ejemplos de proveedores con endpoint compatible:
# OpenAI, Anthropic (vía proxy), OpenRouter, DeepSeek, Google AI Studio, etc.
LLM_API_KEY=

# --- Modelos a usar (los elegís vos) ---
# Formato LiteLLM: <proveedor>/<modelo>. Ejemplos:
#   openai/gpt-4o-mini            (barato, rápido)
#   openai/gpt-4o                 (capaz)
#   anthropic/claude-sonnet-4-20250514
#   openrouter/deepseek/deepseek-chat
#   gemini/gemini-2.0-flash       (Google AI Studio, tiene plan gratuito)
MODELO_BASE=openai/gpt-4o-mini
MODELO_RAZONAMIENTO=openai/gpt-4o
MODELO_LIGERO=openai/gpt-4o-mini

# --- Proxy local (lo genera el setup, podés dejar el valor de ejemplo) ---
LITELLM_MASTER_KEY=clave-maestra-local-cambiala

# --- Runtime de agentes ---
# Dónde escucha el proxy LiteLLM (cámbialo solo si usás otro puerto)
LITELLM_BASE_URL=http://localhost:4000/v1
